# Copy this file to .env and fill it in. Never commit .env.

# Folder for all downloaded and built data (about 7 GB for the full pipeline). Created if missing.
ASKMAP_DATA_ROOT=/path/to/ask_the_map_data

# Google Cloud project ID that is registered for Earth Engine (see docs/earth_engine.md).
# Needed only to build the land tiles (notebooks 01, 15b and 23). It is never printed.
EE_PROJECT=your-earth-engine-cloud-project

# Hugging Face model cache: CLIP and the comparison text model are downloaded here (about 2 GB).
HF_HOME=/path/to/hf_cache

# The Hugging Face token for the language model is read from HF_TOKEN, or from `hf auth login`
# (~/.cache/huggingface/token). It is never written anywhere in this repository.
# HF_TOKEN=
